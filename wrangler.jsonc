// Configuration Cloudflare Workers de la popotte (déployée par Cloudflare à chaque modification de main).
// Le mot de passe du site (SITE_PASSWORD) n'est pas ici : il se règle comme « Secret » sur Cloudflare.
{
  "name": "popotte",
  "main": "worker.js",
  "compatibility_date": "2025-11-01",
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "popotte", "database_id": "f8cfeb20-becb-4b51-819e-ab76330b887a" }
  ],
  "keep_vars": true
}
